<?xml version="1.0" encoding="UTF-8" ?>
<class name="LocalGIVolume3D" inherits="VisualInstance3D" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
		Local probe-grid GI volume. Prototype skeleton; no transport yet.
	</brief_description>
	<description>
		A volume that will own local static/dynamic BVH transport and a regular probe grid. Phase 0 only registers the node, inspector properties, and a no-op [method bake] entry point. Global HDDAGI keeps running; this node does not sample or override GI yet.
		[b]Note:[/b] LocalGI is designed to stay decoupled from HDDAGI internals. External indirect light will enter later only through a [code]GlobalIndirectCache[/code] adapter.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="bake">
			<return type="void" />
			<param index="0" name="from_node" type="Node" default="null" />
			<description>
				Reserved bake entry point. Phase 0 does nothing. Phase 1 will collect static geometry inside the volume and build a CPU BVH in volume local space.
			</description>
		</method>
	</methods>
	<members>
		<member name="debug_mode" type="int" setter="set_debug_mode" getter="get_debug_mode" enum="LocalGIVolume3D.DebugMode" default="0">
			Reserved debug visualization mode. Unused in Phase 0.
		</member>
		<member name="multi_bounce_enabled" type="bool" setter="set_multi_bounce_enabled" getter="is_multi_bounce_enabled" default="false">
			Enables multi-bounce local GI in later phases. Unused in Phase 0.
		</member>
		<member name="probe_spacing" type="float" setter="set_probe_spacing" getter="get_probe_spacing" default="0.5">
			Intended regular probe spacing in volume local meters. Unused in Phase 0.
		</member>
		<member name="rays_per_probe" type="int" setter="set_rays_per_probe" getter="get_rays_per_probe" default="64">
			Intended rays traced per probe. Unused in Phase 0.
		</member>
		<member name="size" type="Vector3" setter="set_size" getter="get_size" default="Vector3(4, 4, 4)">
			Axis-aligned volume size in local meters. The volume is centered on the node origin.
		</member>
		<member name="temporal_hysteresis" type="float" setter="set_temporal_hysteresis" getter="get_temporal_hysteresis" default="0.9">
			Intended temporal EMA hysteresis. Unused in Phase 0.
		</member>
		<member name="update_fraction" type="float" setter="set_update_fraction" getter="get_update_fraction" default="1.0">
			Intended fraction of probes updated per frame. Unused in Phase 0.
		</member>
	</members>
