#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_lrt = env_modules.Clone()
env_lrt.add_source_files(env.modules_sources, "*.cpp")
if "RD_GLSL" in env["BUILDERS"]:
    env_lrt.RD_GLSL("shaders/lrt_geometry_upload.glsl")
    env_lrt.RD_GLSL("shaders/lrt_propagate.glsl")
    env_lrt.RD_GLSL("shaders/lrt_inject.glsl")
    env_lrt.RD_GLSL("shaders/lrt_sky.glsl")
if env.editor_build:
    env_lrt.add_source_files(env.modules_sources, "editor/*.cpp")
