; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Local LRT Test Project"
run/main_scene="res://cornell_box.tscn"
config/features=PackedStringArray("4.7")

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/window_width_override=1152
window/size/window_height_override=648

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
global_illumination/local_lrt/max_volumes_per_camera=1
global_illumination/local_lrt/screen_space_gather=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
